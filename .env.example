# Copy to .env (production) or .env.local (dev). deploy/install.sh creates .env for you on the server.

# Required for the chat agent
ANTHROPIC_API_KEY=
# Optional: defaults to claude-sonnet-4-5
ANTHROPIC_MODEL=claude-sonnet-4-5

# Optional: Postgres. Without it the app reads data/raw/*.csv fixtures.
# deploy/install.sh creates a local database and fills this in.
# DATABASE_URL=postgres://volleyball:PASSWORD@127.0.0.1:5432/volleyball

# Protects /api/refresh (the hourly systemd timer sends it as a Bearer token)
CRON_SECRET=change-me
NSAA_SEASON=2026
NSAA_SEEDING_CUTOFF=2026-10-20

# Where `npm start` listens. nginx proxies the public domain to this port — pick one no other app on the box uses.
PORT=3100
HOST=127.0.0.1

# Deployment (read by deploy/install.sh only)
DOMAIN=volleyball.rocketcore.ai
# Let's Encrypt account / expiry-notice email
CERTBOT_EMAIL=
# systemd unit, Postgres role/database and nginx file names
SERVICE_NAME=volleyball
