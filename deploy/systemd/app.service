# Generated from deploy/systemd/app.service by deploy/install.sh.
[Unit]
Description=NSAA volleyball postseason agent (__DOMAIN__)
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=__USER__
WorkingDirectory=__APP_DIR__
Environment=NODE_ENV=production
# PORT/HOST and everything else come from __APP_DIR__/.env (loaded by scripts/start.mjs)
ExecStart=__NODE__ scripts/start.mjs
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
